# Copia este archivo a .env y completa con tus datos de la Test Wallet (https://wallet.interledger-test.dev)
# Wallet address en formato https:// (no $)
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/tu-wallet
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=./private.key
OP_MOCK=0
PORT=3000
# URL pública del backend (la del túnel). La wallet redirige aquí después del consentimiento: <PUBLIC_URL>/op/finish
PUBLIC_URL=http://localhost:3000
# QR estático de demo (id "demo"): a qué wallet le llega el dinero
DEMO_VENDEDOR_WALLET=https://ilp.interledger-test.dev/tu-vendedor
DEMO_VENDEDOR_NOMBRE=Doña Rita
# Sin cuenta: la Custodia guarda el dinero y le paga al Corresponsal cuando alguien retira con PIN
CUSTODIA_WALLET=https://ilp.interledger-test.dev/custodia-apollo
# QR de demo sin cuenta (id "demo-sin-cuenta"): cédula y celular falsos de quien recibe
DEMO_SINCUENTA_NOMBRE=Don Pedro
DEMO_SINCUENTA_CEDULA=1020304050
DEMO_SINCUENTA_CELULAR=3001234567
